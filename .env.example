# wafpass-server — local development environment
# Copy to .env and source before running: `export $(grep -v '^#' .env | xargs)`
# For Docker Compose use the root .env.example instead (docker compose reads it automatically).

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL async DSN — consumed by SQLAlchemy (engine) and Alembic (migrations).
# Format: postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql+asyncpg://wafpass:changeme@localhost:5432/wafpass

# ── Server ────────────────────────────────────────────────────────────────────
# Environment label shown in logs and /health response.
WAFPASS_ENV=local

# Comma-separated CORS origins allowed to call the API.
# Include the Vite dev server (5173) when developing the dashboard locally.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Architect Sandbox ─────────────────────────────────────────────────────────
# Path to WAF++ control YAML files used by the /api/v1/sandbox endpoint.
# When running the server from wafpass-server/ alongside the monorepo:
WAFPASS_CONTROLS_DIR=../pass/controls

# ── Framework Update Checker ─────────────────────────────────────────────────
# Base path for WAF++ framework repositories.
# When running locally from wafpass-server/, use:
WAFPASS_BASE_PATH=/Users/lewandos/git/waf++

# ── Validation Gateway Integration ────────────────────────────────────────────
# Path to the gateway-issued server sub-CA certificate. In local dev, register
# the server public key at the validation gateway and mount the issued cert here.
# Empty = fall back to the self-generated legacy server.crt in the keys dir.
WAFPASS_SERVER_SUBCA_CERT=

# Shared secret used by the validation gateway when calling the server's
# /api/v1/validations/internal/sign mirror endpoint. Must match the gateway's
# WAFPASS_SERVER_INTERNAL_API_KEY. Empty = internal signing callback is rejected.
WAFPASS_INTERNAL_API_KEY=
